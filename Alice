    local function DetectSeaEvents(forceAll)
        local selected = Settings["Select Sea Events"]
        local hasMultiSelection = type(selected) == "table" and next(selected) ~= nil
        if not hasMultiSelection then
            local singleSelected = Settings["Select Sea Event"]
            if type(singleSelected) == "string" and singleSelected ~= "" then
                selected = {singleSelected}
            else
                selected = {"SeaBeast"}
            end
        elseif type(selected) ~= "table" then
            selected = {selected}
        end
        local function enabled(key)
            if forceAll then return true end
            if selected[key] == true then return true end
            for _, value in ipairs(selected) do if value == key then return true end end
            return false
        end
        local seaBeasts = getSeaBeasts()
        if seaBeasts and enabled("SeaBeast") then
            for _, enemy in ipairs(seaBeasts:GetChildren()) do
                local root = enemy:FindFirstChild("HumanoidRootPart")
                local healthGui = enemy:FindFirstChild("HealthBBG")
                local textLabel = healthGui and healthGui:FindFirstChild("Frame") and healthGui.Frame:FindFirstChild("TextLabel")
                local numeric = textLabel and tonumber((textLabel.Text:gsub("[^%d]", "")))
                if enemy.Name == "SeaBeast1" and root and (not numeric or numeric >= 90000) then return enemy end
            end
        end
        if enabled("Terrorshark") then
            local terror = CheckNameBoss("Terrorshark")
            if terror then return terror end
        end
        if enabled("Ship") then
            local enemies = Workspace:FindFirstChild("Enemies")
            for _, enemy in ipairs(enemies and enemies:GetChildren() or {}) do
                local engine = enemy:FindFirstChild("Engine")
                local health = enemy:FindFirstChild("Health")
                if engine and health and health.Value > 0 then return enemy end
            end
        end
        if enabled("Shark") then
            local shark = DetectMob({"Shark", "Piranha"})
            if shark then return shark end
        end
        if enabled("Piranha") then
            local piranha = DetectMob("Piranha")
            if piranha then return piranha end
        end
        return false
    end

