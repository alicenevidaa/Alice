    local function postWebhook(title, description, enabledSetting)
        if enabledSetting and not Settings[enabledSetting] then return false end
        local webhookKey = tostring(enabledSetting or title or "Kaitun Leviathan")
        local now = os.clock()
        if webhookNextAllowed[webhookKey] and now < webhookNextAllowed[webhookKey] then return false end
        if webhookAttemptNextAllowed[webhookKey] and now < webhookAttemptNextAllowed[webhookKey] then return false end
        webhookAttemptNextAllowed[webhookKey] = now + 5
        local url = Settings["Input Url Webhook"] or Settings["Url Webhook"]
        local requestFunction = getgenv().ExploitReq or request or http_request
        if type(url) ~= "string" or not string.find(url, "discord.com/api/webhooks", 1, true) or type(requestFunction) ~= "function" then
            return false
        end
        local pingText = tostring(Settings["Input Discord Ping"] or "")
        local content = pingText
        local payload = {
            username = "Kaitun Leviathan",
            content = content,
            embeds = {{
                title = tostring(title or "Kaitun Leviathan"),
                description = tostring(description or ""),
                color = 16766720,
                timestamp = DateTime.now():ToIsoDate(),
                footer = {text = "Kaitun Leviathan"}
            }}
        }
        local ok, response = pcall(function()
            return requestFunction({Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpServiceLocal:JSONEncode(payload)})
        end)
        if not ok then return false end
        local statusCode = type(response) == "table" and tonumber(response.StatusCode or response.Status) or nil
        if statusCode and (statusCode < 200 or statusCode >= 300) then return false end
        webhookNextAllowed[webhookKey] = now + 60
        webhookAttemptNextAllowed[webhookKey] = now + 60
        return true
    end

