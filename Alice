    local function GetChests()
        getgenv().Chests = getgenv().Chests or {}
        local targetCount = math.clamp(tonumber(Settings["Value Collect Chest to Hop"]) or 10, 1, 30)
        local chestList = getgenv().Chests
        local seen = {}
        for _, chest in ipairs(chestList) do seen[chest] = true end
        local items = CollectionService:GetTagged("_ChestTagged")
        local playerRoot = getRoot()
        table.sort(items, function(a, b)
            local pa, pb = getPartPosition(a), getPartPosition(b)
            if not playerRoot then return tostring(a) < tostring(b) end
            return pa and pb and (pa - playerRoot.Position).Magnitude < (pb - playerRoot.Position).Magnitude
        end)
        for _, chest in ipairs(items) do
