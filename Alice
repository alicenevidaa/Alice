                ignored.Name = "Ignored"
                ignored.Parent = chest
                if getgenv().ChestsCollected >= target then
                    getgenv().ChestsCollected = 0
                    getgenv().Chests = {}
                    local placeId = game.PlaceId
                    local requestFunction = getgenv().ExploitReq
                    if requestFunction and type(requestFunction) == "function" then
                        local ok, response = pcall(requestFunction, {
                            Url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100",
                            Method = "GET"
                        })
                        if ok and response and response.Body then
                            local decodedOk, data = pcall(function() return HttpServiceLocal:JSONDecode(response.Body) end)
                            if decodedOk and data and data.data then
                                for _, server in ipairs(data.data) do
                                    if server.id and server.playing < server.maxPlayers and server.id ~= game.JobId then
                                        pcall(function() TeleportService:TeleportToPlaceInstance(placeId, server.id, localPlayer) end)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            getgenv().Chests = {}
            local spawnPoint = PathFindChest()
            local position = getPartPosition(spawnPoint)
            if position then MoveToCFrame(CFrame.new(position + Vector3.new(0, 4, 0))) end
        end
    end

