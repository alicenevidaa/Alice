    local function InstallAimPosRemoteHook()
        if getgenv().__KaitunAimPosHookInstalled then return true end
        if not getrawmetatable or not setreadonly or not newcclosure or not getnamecallmethod then return false end
        local ok, mt = pcall(getrawmetatable, game)
        if not ok or not mt or type(mt.__namecall) ~= "function" then return false end
        local oldNamecall = mt.__namecall
        pcall(function() setreadonly(mt, false) end)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            local aim = getgenv().AimPos
            if method == "FireServer" and self.Name == "RemoteEvent" and aim and tostring(aim.X) ~= "nan" then
                if #args == 1 and typeof(args[1]) == "Vector3" then args[1] = aim.Position end
                if #args == 1 and typeof(args[1]) == "CFrame" then args[1] = aim end
            end
            return oldNamecall(self, table.unpack(args))
        end)
        pcall(function() setreadonly(mt, true) end)
        getgenv().__KaitunAimPosHookInstalled = true
        return true
    end

