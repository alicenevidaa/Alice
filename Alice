    local lastStatusSpyText = ""
    local statusSpyBusy = false

    local function BuildStatusSpyText()
        local boat = safeStatusRead(function() return checkboatBeastHunter() end, nil)
        local frozen = safeStatusRead(function() return getFrozenDimension() end, nil)
        local heart = safeStatusRead(function() return getFrozenHeart() end, nil)
        local seaBeasts = safeStatusRead(function() return getSeaBeasts() end, nil)
        local leviathan = nil
        if seaBeasts then
            leviathan = safeStatusRead(function()
                return DetectLeviathan(seaBeasts)
                    or DetectLeviathan(seaBeasts, 2)
                    or DetectLeviathan(seaBeasts, 3)
                    or DetectLeviathan(seaBeasts, 4)
            end, nil)
        end
        local distance = safeStatusRead(function() return DistanceFindLeviathan() end, "N/A")
        local boatName = boat and safeStatusRead(function() return boat.Name end, "Boat found") or "None"
        local huntStatus
        if heart then huntStatus = "Frozen Heart available"
        elseif leviathan then huntStatus = "Leviathan detected"
        elseif frozen then huntStatus = "Frozen Dimension active"
        elseif boat then huntStatus = "Boat ready; searching"
        else huntStatus = "Waiting for boat" end

        local lines = {
            "Player: " .. tostring(localPlayer.Name),
            "Boat: " .. tostring(boatName),
            "Frozen Dimension: " .. tostring(frozen ~= nil and frozen ~= false),
            "Leviathan: " .. tostring(leviathan ~= nil and leviathan ~= false),
            "Frozen Heart: " .. tostring(heart ~= nil and heart ~= false),
            "Distance indicator: " .. tostring(distance),
            "Hunt status: " .. huntStatus,
        }
        return table.concat(lines, "\n")
    end

    local function RefreshStatusSpy()
        if statusSpyBusy then return true, lastStatusSpyText end
        statusSpyBusy = true
        local okBuild, content = pcall(BuildStatusSpyText)
        if not okBuild then
            content = "Status SPY could not read the game state.\n" .. tostring(content)
        end
        content = tostring(content or "Status unavailable")
        local okUpdate, updateError = pcall(function()
            if not StatusSpyParagraph then error("Status SPY paragraph not created") end
            if type(StatusSpyParagraph.SetDesc) == "function" then
                StatusSpyParagraph:SetDesc(content)
            elseif type(StatusSpyParagraph.SetContent) == "function" then
                StatusSpyParagraph:SetContent(content)
            else
                error("Fluent paragraph does not expose SetDesc/SetContent")
            end
        end)
        if not okUpdate then
            content = content .. "\n(UI update error: " .. tostring(updateError) .. ")"
        end
        lastStatusSpyText = content
        statusSpyBusy = false
        return okBuild and okUpdate, content
    end

    local function DetectSeaEvents(forceAll)
        local selected = Settings["Select Sea Events"]
        local hasMultiSelection = type(selected) == "table" and next(selected) ~= nil
        if not hasMultiSelection then
            local singleSelected = Settings["Select Sea Event"]
            if type(singleSelected) == "string" and singleSelected ~= "" then
                selected = {singleSelected}
            else
                selected = {"SeaBeast"}
            end
        elseif type(selected) ~= "table" then
            selected = {selected}
        end
        local function enabled(key)
            if forceAll then return true end
            if selected[key] == true then return true end
            for _, value in ipairs(selected) do if value == key then return true end end
            return false
        end
        local seaBeasts = getSeaBeasts()
        if seaBeasts and enabled("SeaBeast") then
            for _, enemy in ipairs(seaBeasts:GetChildren()) do
                local root = enemy:FindFirstChild("HumanoidRootPart")
                if enemy.Name == "SeaBeast1" and root then return enemy end
            end
        end
        if enabled("Terrorshark") then
            local terror = CheckNameBoss("Terrorshark")
            if terror then return terror end
        end
        if enabled("Shark") then
            local shark = DetectMob({"Shark", "Piranha"})
            if shark then return shark end
        end
        if enabled("Piranha") then
            local piranha = DetectMob("Piranha")
            if piranha then return piranha end
        end
        return false
    end

