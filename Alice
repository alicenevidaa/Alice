    local function MoveBoatToCFrame(boat, target, speed)
        if not boat or not target or typeof(target) ~= "CFrame" then return false end
        local seat = boat:FindFirstChild("VehicleSeat", true)
        if not seat or not seat:IsA("BasePart") then return false end
        local distance = (seat.Position - target.Position).Magnitude
        if distance <= 20 then
            local previousState = getgenv().__KaitunBoatTweenState
            if previousState and previousState.tween then
                pcall(function() previousState.tween:Cancel() end)
            end
            getgenv().__KaitunBoatTweenState = nil
            getgenv().TweenBoat = nil
            return true
        end

        local activeState = getgenv().__KaitunBoatTweenState
        if activeState and activeState.seat == seat and activeState.tween
            and activeState.tween.PlaybackState == Enum.PlaybackState.Playing
            and activeState.target and (activeState.target.Position - target.Position).Magnitude <= 15 then
            return true
        end
        if activeState and activeState.tween then
            pcall(function() activeState.tween:Cancel() end)
        elseif getgenv().TweenBoat then
            pcall(function() getgenv().TweenBoat:Cancel() end)
        end

        local tweenSpeed = math.max(tonumber(speed) or tonumber(Settings["Input Speed Boat Auto Drive"]) or 250, 50)
        local ok, tween = pcall(function()
            return TweenService:Create(seat, TweenInfo.new(distance / tweenSpeed, Enum.EasingStyle.Linear), {CFrame = target})
        end)
        if not ok or not tween then return false end

        local state = {seat = seat, target = target, tween = tween}
        getgenv().__KaitunBoatTweenState = state
        getgenv().TweenBoat = tween
        tween.Completed:Connect(function()
            if getgenv().__KaitunBoatTweenState == state then
                getgenv().__KaitunBoatTweenState = nil
                getgenv().TweenBoat = nil
            end
        end)
        tween:Play()
        return true
    end

