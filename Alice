    local function RefreshStatusSpy()
        if statusSpyBusy then return true, lastStatusSpyText end
        statusSpyBusy = true
        local okBuild, content = pcall(BuildStatusSpyText)
        if not okBuild then
            content = "Status SPY could not read the game state.\n" .. tostring(content)
        end
        content = tostring(content or "Status unavailable")

        local okUpdate, updateError = pcall(function()
            if not StatusSpyParagraph then error("Status SPY paragraph was not created") end
            if type(StatusSpyParagraph.SetDesc) == "function" then
                StatusSpyParagraph:SetDesc(content)
            elseif type(StatusSpyParagraph.SetContent) == "function" then
                StatusSpyParagraph:SetContent(content)
            else
                error("Fluent paragraph does not expose SetDesc/SetContent")
            end
        end)
        if not okUpdate then
            content = content .. "\n(UI update error: " .. tostring(updateError) .. ")"
        end
        lastStatusSpyText = content
        statusSpyBusy = false
        return okBuild and okUpdate, content
    end

