    local function GetPlayerNears(radius)
        local root = getRoot()
        local results = {}
        if not root then return results end
        radius = tonumber(radius) or 1200
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer then
                local otherRoot = getRoot(player.Character)
                if otherRoot then
                    local distance = (otherRoot.Position - root.Position).Magnitude
                    if distance <= radius then
                        table.insert(results, {Player = player, Distance = distance, Root = otherRoot})
                    end
                end
            end
        end
        table.sort(results, function(a, b) return a.Distance < b.Distance end)
        return results
    end

